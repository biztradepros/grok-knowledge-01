{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "df.character.master_lock.v1",
  "title": "MASTER LOCK",
  "description": "잠근 뒤에는 바꾸지 않는다. 바꾸려면 새 버전을 만들고 supersedes 로 잇는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_id", "character_id", "version", "master_candidate_ids", "master_media", "identity_eval",
               "rights_checklist", "approvals", "locked_at", "immutable"],
  "properties": {
    "lock_id": {"type": "string", "pattern": "^DF-LOCK-[A-Z0-9-]{3,60}$"},
    "character_id": {"type": "string", "pattern": "^DF-CHAR-[A-Z0-9-]{2,40}$"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supersedes": {"type": ["string", "null"]},
    "master_candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "master_media": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["view", "generation_id", "sha256"],
      "properties": {"view": {"enum": ["front", "three_quarter_left", "three_quarter_right", "profile", "full_body", "sheet"]},
                     "generation_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "higgsfield": {"type": "object", "additionalProperties": false,
      "properties": {"element_id": {"type": ["string", "null"]}, "soul_id": {"type": ["string", "null"]},
                     "created_from_generation_ids": {"type": "array", "items": {"type": "string"}}}},
    "identity_eval": {"type": "object", "required": ["engine_version", "policy", "intra_master_min_cosine", "protected_max_cosine"],
      "properties": {"engine_version": {"type": "string"}, "policy": {"type": "object"},
                     "intra_master_min_cosine": {"type": "number"}, "protected_max_cosine": {"type": "object"}}},
    "rights_checklist": {"type": "object", "additionalProperties": false,
      "required": ["no_real_person_identity_input", "references_rights_cleared", "model_terms_commercial_ok", "protected_distinct"],
      "properties": {"no_real_person_identity_input": {"const": true},
                     "references_rights_cleared": {"const": true},
                     "model_terms_commercial_ok": {"const": true},
                     "protected_distinct": {"const": true},
                     "lookalike_review_note": {"type": "string"}}},
    "approvals": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["role", "by", "at", "decision"],
      "properties": {"role": {"enum": ["human_owner", "gpt_hq", "rights_reviewer"]}, "by": {"type": "string"},
                     "at": {"type": "string", "format": "date-time"}, "decision": {"enum": ["approve", "reject"]}}},
      "contains": {"properties": {"role": {"const": "human_owner"}, "decision": {"const": "approve"}}, "required": ["role", "decision"]}},
    "locked_at": {"type": "string", "format": "date-time"},
    "immutable": {"const": true}
  }
}
