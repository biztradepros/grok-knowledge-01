{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "df.character.candidate.v1",
  "title": "얼굴 후보",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "character_id", "round", "state", "engine", "request", "cost"],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^DF-CAND-[A-Z0-9-]{3,60}$"},
    "character_id": {"type": "string", "pattern": "^DF-CHAR-[A-Z0-9-]{2,40}$"},
    "round": {"type": "integer", "minimum": 1},
    "parent_candidate_id": {"type": ["string", "null"]},
    "state": {"enum": ["QUOTED", "APPROVED_TO_SPEND", "GENERATING", "ASSET_READY", "EVALUATED",
                       "SHORTLISTED", "REJECTED", "MASTER_CANDIDATE", "FAILED"]},
    "engine": {"type": "object", "additionalProperties": false, "required": ["provider", "model"],
      "properties": {"provider": {"enum": ["higgsfield", "comfyui_external_gpu"]},
                     "model": {"type": "string"}, "tool": {"type": "string"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["prompt"],
      "properties": {"prompt": {"type": "string", "maxLength": 4000},
                     "selection": {"type": "object"},
                     "seed": {"type": ["integer", "null"]},
                     "reference_ids": {"type": "array", "items": {"type": "string"}},
                     "element_ids": {"type": "array", "items": {"type": "string"}}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["quoted_credits"],
      "properties": {"quoted_credits": {"type": "number", "minimum": 0},
                     "actual_credits": {"type": ["number", "null"], "minimum": 0},
                     "approved_by": {"type": ["string", "null"]},
                     "approved_at": {"type": ["string", "null"], "format": "date-time"}}},
    "result": {"type": "object", "additionalProperties": false,
      "properties": {"generation_id": {"type": "string"}, "job_id": {"type": "string"},
                     "media_url": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                     "width": {"type": "integer"}, "height": {"type": "integer"}}},
    "identity_eval": {"type": "object", "description": "DF-ENGINE-IDENTITY-001 결과 요약",
      "properties": {"engine_version": {"type": "string"}, "verdict": {"enum": ["PASS_CANDIDATE", "REVIEW", "FAIL_DRIFT", "BLOCK_PROTECTED", "ERROR"]},
                     "master_cosine_max": {"type": "number"}, "protected_cosine_max": {"type": "object"},
                     "policy": {"type": "object"}}},
    "review": {"type": "object", "additionalProperties": false,
      "properties": {"scores": {"type": "object", "description": "brief_fit, premium_feel, distinctiveness, likeness_risk 1~5"},
                     "decision": {"enum": ["keep", "reject", "iterate"]}, "reviewer": {"type": "string"}, "note": {"type": "string"}}}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["GENERATING", "ASSET_READY", "EVALUATED", "SHORTLISTED", "MASTER_CANDIDATE"]}}},
     "then": {"properties": {"cost": {"required": ["quoted_credits", "approved_by", "approved_at"],
              "properties": {"approved_by": {"type": "string"}}}}}}
  ]
}
